rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened global helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'role', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 256
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024))
        && (!('role' in data) || (data.role is string && data.role.size() <= 32))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidItem(data) {
      return data.keys().hasAll(['title', 'ownerId', 'ownerEmail', 'status', 'category', 'priority'])
        && data.keys().hasOnly(['id', 'title', 'description', 'category', 'priority', 'status', 'ownerId', 'ownerEmail', 'ownerName', 'tags', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && (!('description' in data) || (data.description is string && data.description.size() <= 2000))
        && data.category is string && data.category in ['task', 'note', 'milestone', 'idea']
        && data.priority is string && data.priority in ['low', 'medium', 'high', 'urgent']
        && data.status is string && data.status in ['todo', 'in_progress', 'completed']
        && data.ownerId is string && data.ownerId == request.auth.uid
        && data.ownerEmail is string && data.ownerEmail.size() <= 256
        && (!('ownerName' in data) || (data.ownerName is string && data.ownerName.size() <= 128))
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 10))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidActivity(data) {
      return data.keys().hasAll(['userId', 'action', 'targetTitle'])
        && data.keys().hasOnly(['id', 'userId', 'userEmail', 'action', 'targetTitle', 'createdAt'])
        && data.userId is string && data.userId == request.auth.uid
        && data.action is string && data.action.size() <= 64
        && data.targetTitle is string && data.targetTitle.size() <= 120
        && (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 256))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    // Connection health test endpoint for initial boot validation
    match /test/{testId} {
      allow get: if true;
    }

    // User profile documents - private to owner
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming())
                    && incoming().uid == existing().uid;
    }

    // Workspace Items (Tasks, notes, milestones)
    match /items/{itemId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(itemId) && isValidItem(incoming()) && incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(itemId)
                    && isValidItem(incoming())
                    && existing().ownerId == request.auth.uid
                    && incoming().ownerId == existing().ownerId
                    && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'category', 'priority', 'status', 'tags', 'updatedAt', 'id', 'ownerEmail', 'ownerName', 'createdAt']);
      allow delete: if isSignedIn() && isValidId(itemId) && existing().ownerId == request.auth.uid;
    }

    // Workspace Activity Feed - Append only for audit logging
    match /activities/{activityId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(activityId) && isValidActivity(incoming());
      allow update, delete: if false;
    }
  }
}
